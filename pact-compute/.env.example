# Local defaults use SQLite in .local and bind to loopback.
PACT_URL=http://127.0.0.1:8765
# PACT_DATABASE_URL=postgresql+pg8000://pact:URL_ENCODED_PASSWORD@HOST:5432/pact
# PACT_DB_TLS=1
# PACT_SOURCE_DIR=C:/path/to/PACT-Compute-data-preflight
# PACT_GPU_PYTHON=C:/path/to/CUDA/environment/Scripts/python.exe
# PACT_GPU_ENGINE=torch
# Set a verified runner grid zone. GB enables the open NESO forecast connector.
# PACT_RUNNER_GRID_ZONE=GB
# PACT_RUNNER_POWER_BOUND_W=120
# Optional Groq assistance. Admission, booking, execution, auditing and benchmarks run locally.
# GROQ_API_KEY=YOUR_GROQ_API_KEY
# GROQ_MODEL=openai/gpt-oss-20b
# Optional alternative structured extraction provider.
# PACT_LLM_BASE_URL=https://api.openai.com/v1
# PACT_LLM_API_KEY=
# PACT_LLM_MODEL=
# Enable only behind a configured HTTPS origin.
# PACT_SECURE_COOKIE=1
